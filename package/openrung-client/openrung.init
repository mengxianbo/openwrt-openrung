#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/libexec/openrung-client.bin
WRAPPER=/usr/bin/openrung-client

start_service() {
    config_load openrung
    config_get_bool enabled main enabled 1
    [ "$enabled" -eq 1 ] || {
        logger -t openrung "Service disabled in /etc/config/openrung"
        return 0
    }

    config_get mode main mode proxy
    [ "$mode" = "proxy" ] || {
        logger -t openrung "Unsupported mode '$mode'; this build supports proxy mode only"
        return 1
    }

    [ -x "$PROG" ] || {
        logger -t openrung "Client binary missing: $PROG"
        return 1
    }
    [ -x "$WRAPPER" ] || {
        logger -t openrung "Client wrapper missing: $WRAPPER"
        return 1
    }

    config_get proxy_port main proxy_port 44025
    case "$proxy_port" in
        ''|*[!0-9]*) proxy_port=44025 ;;
    esac
    if [ "$proxy_port" -lt 1 ] 2>/dev/null || [ "$proxy_port" -gt 65535 ] 2>/dev/null; then
        logger -t openrung "Invalid proxy_port; falling back to 44025"
        proxy_port=44025
    fi

    config_get selection_mode main selection_mode auto
    config_get relay_id main relay_id
    if [ "$selection_mode" = "manual" ] && [ -z "$relay_id" ]; then
        logger -t openrung "Manual selection requires a Relay ID; refusing automatic fallback"
        return 1
    fi
    config_get relay_country main relay_country
    config_get relay_label main relay_label

    procd_open_instance
    procd_set_param env HOME=/root XDG_CONFIG_HOME=/root/.config OPENRUNG_PROXY_PORT="$proxy_port"
    procd_set_param command "$WRAPPER" connect -headless
    # Auto mode must never inherit a previously saved exact relay ID.
    if [ "$selection_mode" = "manual" ] && [ -n "$relay_id" ]; then
        procd_append_param command -relay-id "$relay_id"
    fi
    [ -n "$relay_country" ] && procd_append_param command -relay-country "$relay_country"
    [ -n "$relay_label" ] && procd_append_param command -relay-label "$relay_label"
    procd_set_param respawn 3600 5 0
    procd_set_param term_timeout 30
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance

    logger -t openrung "procd instance registered; selection=$selection_mode local proxy target 127.0.0.1:$proxy_port"
}

service_triggers() {
    procd_add_reload_trigger openrung
}

reload_service() {
    stop
    start
}

service_running() {
    ubus call service list '{"name":"openrung"}' 2>/dev/null |
        grep -q '"pid"[[:space:]]*:[[:space:]]*[0-9]'
}

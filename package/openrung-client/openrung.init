#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

# The OpenRung CLI resolves its stable proxy endpoint from
# OPENRUNG_PROXY_PORT. Pin it here so no persisted/random port can override it.
OPENRUNG_PORT=44025

start_service() {
    config_load openrung
    config_get_bool enabled main enabled 0
    [ "$enabled" -eq 1 ] || {
        logger -t openrung "Service disabled in /etc/config/openrung"
        return 0
    }

    config_get mode main mode proxy
    [ "$mode" = "proxy" ] || {
        logger -t openrung "TUN mode is disabled in this package build; use proxy mode"
        return 1
    }

    config_get relay_id main relay_id
    config_get relay_country main relay_country
    config_get relay_label main relay_label

    procd_open_instance
    # procd starts services with a minimal environment. Go's os.UserConfigDir()
    # needs HOME or XDG_CONFIG_HOME; without these clientstate.New() fails and
    # the headless client exits before connecting.
    procd_set_param env HOME=/root XDG_CONFIG_HOME=/root/.config OPENRUNG_PROXY_PORT="$OPENRUNG_PORT"
    procd_set_param command /usr/bin/openrung-client connect -headless
    [ -n "$relay_id" ] && procd_append_param command -relay-id "$relay_id"
    [ -n "$relay_country" ] && procd_append_param command -relay-country "$relay_country"
    [ -n "$relay_label" ] && procd_append_param command -relay-label "$relay_label"
    # retry=0 means unlimited retries; a repeated short crash must not leave
    # the router permanently without its local proxy service.
    procd_set_param respawn 3600 5 0
    procd_set_param term_timeout 30
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger openrung
}

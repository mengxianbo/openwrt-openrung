#!/bin/sh
# JianxianApp WebRTC Leak Guard - GPL-3.0-or-later
set -eu
. /lib/functions.sh
CONFIG_SECTION="main"
config_load webrtc_guard
config_get ENABLED "$CONFIG_SECTION" enabled "0"
config_get MODE "$CONFIG_SECTION" mode "smart"
config_get LAN_IFACE "$CONFIG_SECTION" lan_ifname "br-lan"

remove_rules() { nft delete table inet webrtc_guard 2>/dev/null || true; }
valid_ipv4() {
	printf '%s' "$1" | awk -F. 'NF != 4 {exit 1} {for(i=1;i<=4;i++) if($i !~ /^[0-9]+$/ || $i > 255) exit 1}'
}
valid_ipv6() { printf '%s' "$1" | grep -Eiq '^[0-9a-f:]+$'; }

add_device() {
	local section="$1" ip4 ip6 policy
	config_get ip4 "$section" ipv4 ""
	config_get ip6 "$section" ipv6 ""
	config_get policy "$section" policy "smart"
	case "$policy" in smart|strict) ;; *) echo "ERROR: invalid policy in $section" >&2; return 1 ;; esac
	if [ -n "$ip4" ]; then
		valid_ipv4 "$ip4" || { echo "ERROR: invalid IPv4 in $section" >&2; return 1; }
		case "$policy" in
			smart) nft add element inet webrtc_guard smart4 "{ $ip4 }" ;;
			strict) nft add element inet webrtc_guard strict4 "{ $ip4 }" ;;
		esac
	fi
	if [ -n "$ip6" ]; then
		valid_ipv6 "$ip6" || { echo "ERROR: invalid IPv6 in $section" >&2; return 1; }
		case "$policy" in
			smart) nft add element inet webrtc_guard smart6 "{ $ip6 }" ;;
			strict) nft add element inet webrtc_guard strict6 "{ $ip6 }" ;;
		esac
	fi
	[ -n "$ip4$ip6" ] || { echo "ERROR: device $section needs an IPv4 or IPv6 address" >&2; return 1; }
}

apply_rules() {
	if [ "$ENABLED" != "1" ]; then remove_rules; echo "WebRTC Leak Guard is disabled."; return 0; fi
	command -v nft >/dev/null 2>&1 || { echo "ERROR: nft command not found" >&2; return 1; }
	printf '%s' "$LAN_IFACE" | grep -Eq '^[A-Za-z0-9_.:-]{1,15}$' || { echo "ERROR: invalid LAN interface" >&2; return 1; }
	case "$MODE" in smart|strict|device) ;; *) echo "ERROR: invalid mode: $MODE" >&2; return 1 ;; esac
	remove_rules
	nft -f - <<EOF
table inet webrtc_guard {
	set smart4 { type ipv4_addr; }
	set smart6 { type ipv6_addr; }
	set strict4 { type ipv4_addr; }
	set strict6 { type ipv6_addr; }
	chain forward { type filter hook forward priority -5; policy accept; }
}
EOF
	case "$MODE" in
		smart)
			nft add rule inet webrtc_guard forward iifname "$LAN_IFACE" udp dport { 3478, 5349, 19302-19309 } counter drop comment '"webrtc-guard-smart-stun"'
			;;
		strict)
			nft add rule inet webrtc_guard forward iifname "$LAN_IFACE" udp dport != { 53, 123 } counter drop comment '"webrtc-guard-strict-udp"'
			nft add rule inet webrtc_guard forward iifname "$LAN_IFACE" tcp dport { 3478, 5349 } counter drop comment '"webrtc-guard-strict-tcp"'
			;;
		device)
			config_foreach add_device device
			nft add rule inet webrtc_guard forward iifname "$LAN_IFACE" ip saddr @smart4 udp dport { 3478, 5349, 19302-19309 } counter drop comment '"webrtc-guard-device-smart4"'
			nft add rule inet webrtc_guard forward iifname "$LAN_IFACE" ip6 saddr @smart6 udp dport { 3478, 5349, 19302-19309 } counter drop comment '"webrtc-guard-device-smart6"'
			nft add rule inet webrtc_guard forward iifname "$LAN_IFACE" ip saddr @strict4 udp dport != { 53, 123 } counter drop comment '"webrtc-guard-device-strict4"'
			nft add rule inet webrtc_guard forward iifname "$LAN_IFACE" ip6 saddr @strict6 udp dport != { 53, 123 } counter drop comment '"webrtc-guard-device-strict6"'
			nft add rule inet webrtc_guard forward iifname "$LAN_IFACE" ip saddr @strict4 tcp dport { 3478, 5349 } counter drop comment '"webrtc-guard-device-strict-tcp4"'
			nft add rule inet webrtc_guard forward iifname "$LAN_IFACE" ip6 saddr @strict6 tcp dport { 3478, 5349 } counter drop comment '"webrtc-guard-device-strict-tcp6"'
			;;
	esac
	echo "WebRTC Leak Guard active: mode=$MODE interface=$LAN_IFACE"
}
case "\${1:-}" in
	apply) apply_rules ;;
	remove) remove_rules ;;
	status) if nft list table inet webrtc_guard >/dev/null 2>&1; then nft list table inet webrtc_guard; else echo "WebRTC Leak Guard rules are not active."; fi ;;
	*) echo "Usage: $0 {apply|remove|status}" >&2; exit 2 ;;
esac
